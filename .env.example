# Postgres — docker-compose Postgres locally; Supabase connection string in production
# For production with Supabase, use the connection pooling URL for better performance:
# postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://trustee:trustee@localhost:5432/trustee?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
# For production, set NEXTAUTH_URL to your production domain (e.g., https://trustee-marketplace.vercel.app)

# Monnify sandbox — https://developers.monnify.com/
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_BASE_URL="https://sandbox.monnify.com"

# Supabase — used for Postgres in production (see DATABASE_URL) and Storage for listing photos
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="listing-photos"

# Groq — used for dispute-resolution suggestions and scam-signal listing screening
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Resend — used to send password-reset emails. "onboarding@resend.dev" works
# without verifying your own domain, good enough for local dev/demo.
RESEND_API_KEY=""
EMAIL_FROM="Trustee <onboarding@resend.dev>"

# Admin seed — optional, used by `pnpm seed` to create/promote the admin account
# Defaults: admin@trustee.dev / AdminPassword123! / "Trustee Admin" if left unset
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Escrow business rules
PLATFORM_FEE_BPS="500"
AUTO_RELEASE_DAYS="5"
SHIPPING_GRACE_DAYS="3"
# How long a listing stays reserved (SOLD) for an abandoned/unpaid checkout
# before another buyer can reclaim it.
CHECKOUT_EXPIRY_MINUTES="30"
