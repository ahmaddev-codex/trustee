// Prisma schema for Trustee — P2P classifieds escrow powered by Monnify
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  SOLD
  REMOVED
}

enum OrderStatus {
  AWAITING_PAYMENT
  FUNDED
  SHIPPED
  RELEASED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  RESOLVED_RELEASE
  RESOLVED_REFUND
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  role              Role     @default(USER)
  image             String?

  bankAccountNumber String?
  bankCode          String?
  bankAccountName   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  listings          Listing[]
  buyerOrders       Order[]      @relation("BuyerOrders")
  sellerOrders      Order[]      @relation("SellerOrders")
  disputesRaised    Dispute[]
  notifications     Notification[]
  passwordResetTokens PasswordResetToken[]
  cartItems         CartItem[]

  @@map("users")
}

model CartItem {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("cart_items")
}

model PasswordResetToken {
  id        String    @id @default(cuid())

  userId    String
  user      User      @relation(fields: [userId], references: [id])

  // SHA-256 hash of the raw token mailed to the user — never store the raw
  // token, so a DB read alone can't be used to reset someone's password.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Listing {
  id          String        @id @default(cuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])

  title       String
  description String
  priceKobo   BigInt
  imageUrls   String[]
  category    String
  status      ListingStatus @default(ACTIVE)

  aiFlagged     Boolean @default(false)
  aiFlagReason  String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders      Order[]
  cartItems   CartItem[]

  @@index([status])
  @@map("listings")
}

model Order {
  id     String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  buyerId  String
  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id])

  amountKobo      BigInt
  platformFeeKobo BigInt
  status          OrderStatus @default(AWAITING_PAYMENT)

  // Not unique: a cart checkout shares one reference across several orders
  // (one per seller). A single-item purchase still gets a globally-unique
  // reference in practice (trustee-${order.id}) since order IDs are unique.
  monnifyPaymentReference    String
  monnifyTransactionRef      String?
  monnifyDisbursementRef     String?

  fundedAt      DateTime?
  shippedAt     DateTime?
  autoReleaseAt DateTime?
  releasedAt    DateTime?
  refundedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disputes Dispute[]

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([monnifyPaymentReference])
  @@map("orders")
}

model Dispute {
  id           String        @id @default(cuid())

  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])

  raisedById   String
  raisedBy     User          @relation(fields: [raisedById], references: [id])

  reason         String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("disputes")
}

model Notification {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model WebhookEvent {
  id               String    @id @default(cuid())
  eventType        String
  paymentReference String
  rawPayload       Json
  processedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([paymentReference])
  @@map("webhook_events")
}
