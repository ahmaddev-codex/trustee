# One-off image for applying Prisma migrations and seeding the admin
# account against a target database.
#
# Build:
#   docker build -f Dockerfile.migrate -t trustee-migrate .
#
# Run (applies pending migrations, then creates/promotes the admin user):
#   docker run --rm \
#     -e DATABASE_URL="postgresql://user:pass@host:5432/postgres" \
#     -e ADMIN_EMAIL="admin@trustee.dev" \
#     -e ADMIN_PASSWORD="change-me" \
#     -e ADMIN_NAME="Trustee Admin" \
#     trustee-migrate

FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10 --activate

COPY package.json pnpm-lock.yaml prisma.config.ts ./
COPY prisma ./prisma

RUN pnpm install --frozen-lockfile

CMD ["sh", "-c", "pnpm exec prisma migrate deploy && pnpm exec prisma db seed"]
